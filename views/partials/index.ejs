<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Hi and welcome <%= username %></h1>
    <% if (blogs.length > 0) { %>
        <% blogs.forEach(blog => { %>
            <div>
                <p><%= blog.title %></p>
                <p><%= blog.snippet %></p>
            </div>
        <% }) %>
    <% } else { %>
        <p>There is no blogs</p>
    <% } %> 
</body>
</html>